# Runtime
NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# PostgreSQL (required outside the in-memory local demo)
DATABASE_URL=postgres://user:password@localhost:5432/gratitude_stories

# Staff access: use separate long, random values in production.
# STAFF_ACCESS_TOKEN is a temporary legacy fallback only.
STAFF_ADMIN_TOKEN=
STAFF_OPERATIONS_TOKEN=
STAFF_ACCESS_TOKEN=
METRICS_TOKEN=

# The public origin printed into every card's QR code. It can never change once cards are printed.
# Required in production before the staff console will issue cards; defaults to the request host in development.
PUBLIC_BASE_URL=https://app.example.com

# Optional: WhatsApp support number in international format (digits only, e.g. 2348030000000).
# When set, the help page shows a "Message us on WhatsApp" button prefilled with the box number.
SUPPORT_WHATSAPP_NUMBER=

# Deferred payment rollout. Configure only when enabling Paystack.
PASS_ON_AMOUNT_KOBO=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://app.example.com/checkout/complete
