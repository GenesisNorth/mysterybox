{
  "name": "gratitude-stories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx watch --env-file=.env.local src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/src/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migration-status.ts",
    "db:migrate:built": "node --enable-source-maps dist/scripts/migrate.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "qrcode": "^1.5.4"
  }
}
